# Flotiq API key (read-only is enough for a site that only displays content).
# Used by the SDK at runtime and by `npm run typegen`.
FLOTIQ_API_KEY=

# Random secret shared with Flotiq: guards /api/flotiq/draft and /api/flotiq/revalidate.
# Generate one with: openssl rand -hex 32
FLOTIQ_CLIENT_AUTH_KEY=
